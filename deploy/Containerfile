# Production image; dev/Containerfile is a development environment
#
# Build from the repo root:
#   podman build -t sessionbin -f deploy/Containerfile .
FROM quay.io/fedora/fedora:44

RUN dnf install -y --setopt=install_weak_deps=False python3 gitleaks sqlite \
    && dnf clean all

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app

# Enforce use of system Python
ENV UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
RUN uv sync --frozen --no-dev

ENV DJANGO_SETTINGS_MODULE=sessionbin.conf.settings.prod \
    PATH="/app/.venv/bin:${PATH}"

# Throwaway key just to run collectstatic
RUN DJANGO_SECRET_KEY=build-only python src/sessionbin/manage.py collectstatic --noinput

EXPOSE 8000

# Allow higher timeout limit for larger uploads
CMD ["gunicorn", "sessionbin.conf.wsgi:application", \
     "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "60"]
